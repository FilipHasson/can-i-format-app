{
  "name": "can-i-format-app",
  "version": "0.1.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Audit physical media (SD/CFexpress/SSD) against your media libraries and answer: can I format this card?",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilipHasson/can-i-format-app.git"
  },
  "type": "module",
  "productName": "Can I Format",
  "main": "electron/main.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "can-i-format": "src/cli.ts",
    "cif": "src/cli.ts"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/cli.ts --port 4111 --no-open",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const p of ['dist', 'build', 'fixtures', 'tmp']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "app": "npm run icon --silent && electron .",
    "app:smoke": "npm run icon --silent && electron electron/smoke.ts",
    "icon": "node tools/make-icon.ts build/icon.ico",
    "package": "npm run icon --silent && electron-packager . --overwrite --out=dist --asar --icon=build/icon.ico --app-copyright=\"Filip Hasson\" --ignore=\"^/(test|tools|dist|fixtures|\\.github)($|/)\" --ignore=\"^/build/(preview|smoke)\" --ignore=\"^/(tsconfig|CLAUDE)\\.\"",
    "fixtures": "node tools/make-fixtures.ts",
    "probe": "node --disable-warning=ExperimentalWarning tools/preview-probe.ts",
    "probe:catalog": "node --disable-warning=ExperimentalWarning tools/catalog-probe.ts",
    "probe:pool": "node --disable-warning=ExperimentalWarning tools/pool-probe.ts"
  },
  "dependencies": {
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "electron": "^43.4.1",
    "typescript": "^5.7.0"
  }
}
